# Copy this file to .env and fill in values for your project.
# .env is gitignored and never committed.

# Used as the PostgreSQL database name prefix.
# Example: APP_NAME=bookmarky → databases: bookmarky_development, bookmarky_test
APP_NAME=myapp

# PostgreSQL connection (optional — defaults to local socket / current OS user)
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
